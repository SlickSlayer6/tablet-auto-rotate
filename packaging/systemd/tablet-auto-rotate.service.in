[Unit]
Description=Automatic display and touchscreen rotation
Documentation=https://github.com/SlickSlayer6/tablet-auto-rotate
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=@EXECUTABLE@
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=graphical-session.target
